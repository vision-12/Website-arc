{
  "name": "altrastate-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:school-values": "node scripts/check-school-values.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "prepare": "husky || true",
    "verify": "npm run typecheck && npm run lint && npm run check:school-values && npm run test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fast-check": "4.11.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "playwright-core": "1.63.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
