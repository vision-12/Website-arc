# Copy to .env.local for development. Never commit real values.
# Validated at build/boot by src/lib/env/schema.ts — the build fails on missing or malformed values.

# ── Identity ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SCHOOL_SLUG=demo-school                      # logs, storage prefixes, installations registry

# ── Supabase (new key model; legacy anon/service_role keys are not used) ─────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=                          # sb_secret_… server-only; only src/lib/supabase/admin.ts may read it (phase 2)

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=                               # phase 11
EMAIL_FROM=                                   # "School Name <no-reply@school-domain>"
EMAIL_ADMISSIONS_INBOX=                       # phase 12
RESEND_WEBHOOK_SECRET=                        # phase 14

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_PROVIDER=osm                  # google | maptiler | osm
NEXT_PUBLIC_MAP_PUBLIC_KEY=                   # referrer-restricted to the school domain (phase 11)

# ── Ops (generate each with: openssl rand -base64 48) ────────────────────────
CRON_SECRET=                                  # phase 4
PREVIEW_TOKEN_SECRET=                         # phase 4
FORM_SIGNING_SECRET=                          # phase 2 — also stored in Supabase Vault (spec D5)
IP_HASH_SALT=                                 # phase 2 — also stored in Supabase Vault (spec D10)
SENTRY_DSN=                                   # optional
